# Cloudflare Pages header rules.
#
# iOS Safari will not play a video unless the host honours HTTP byte-range
# requests. Ours was answering `Range: bytes=0-1023` with a 200 and the whole
# file instead of a 206 — fine on desktop, fatal on iPhone. `no-transform`
# tells Cloudflare to leave the payload alone; it cannot serve ranges out of a
# representation it has re-encoded or compressed.

/*.mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable, no-transform

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable
